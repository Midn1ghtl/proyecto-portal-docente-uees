{
  "openapi": "3.0.0",
  "info": {
    "title": "API del portal docente de la Universidad Evangélica de El Salvador",
    "version": "3.0.0",
    "description": "Esta API proporciona los endpoints necesarios para el portal docente. Permite: inciar sesión, obtener información de cursos, gestionar calificaciones, generar informes, exportar a excel y actualizar información del docente."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "backend local para desarrollo"
    }
  ],
  "tags": [
    {
      "name": "Inicio_sesion",
      "description": "Endpoints relacionados con el inicio de sesión de los docentes."
    },
    {
      "name": "Docente",
      "description": "Endpoints relacionados con la información del docente."
    },
    {
      "name": "Cursos",
      "description": "Endpoints relacionados con la información de los cursos."
    },
    {
      "name": "Estudiantes",
      "description": "Endpoints relacionados con la gestión de estudiantes."
    },
    {
      "name": "Calificaciones",
      "description": "Endpoints relacionados con la gestión de calificaciones."
    },
    {
      "name": "Publicación",
      "description": "Endpoints relacionados con la publicación de calificaciones."
    },
    {
      "name": "Reportes",
      "description": "Endpoints relacionados con la generación de reportes e informes."
    }
  ],
  "paths": {
    "/api/v1/login": {
      "post": {
        "tags": [
          "Inicio_sesion"
        ],
        "summary": "Iniciar sesión como docente",
        "description": "Este endpoint permite a los docentes iniciar sesión en el sistema proporcionando sus credenciales.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/loginRequest"
              },
              "example": {
                "dui": "00000000-0",
                "contrasena": "123456789"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inicio de sesión exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/login"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profesor/{profesorId}/cursos": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Obtener la información de los cursos",
        "description": "Método para obtener la información detallada de un curso.",
        "parameters": [
          {
            "name": "profesorId",
            "in": "path",
            "required": true,
            "description": "Id del docente.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de cursos del docente (puede estar vacía)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/cursoRes"
                }
              }
            }
          },
          "404": {
            "description": "Docente no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cursos/{cursoId}": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Obtener detalles del curso",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Se encontró el curso solicitado con éxito.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/curso"
                }
              }
            }
          },
          "404": {
            "description": "No se encontró el curso solicitado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cursos/{cursoId}/estudiantes": {
      "get": {
        "tags": [
          "Estudiantes"
        ],
        "summary": "Obtener la lista de estudiantes de un curso",
        "description": "Método para obtener la lista de estudiantes matriculados en el curso.",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "description": "Id del curso.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de estudiantes obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/listEstudiante"
                }
              }
            }
          },
          "404": {
            "description": "Curso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cursos/{cursoId}/estudiantes/cargaMasiva": {
      "post": {
        "tags": [
          "Estudiantes"
        ],
        "summary": "Carga masiva de estudiantes",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Identificador del curso"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "archivo"
                ],
                "properties": {
                  "archivo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo .xlsx o .csv"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estudiantes incorporados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/cargaEstudiantes"
                }
              }
            }
          },
          "400": {
            "description": "Archivo inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Curso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cursos/{cursoId}/calificaciones": {
      "get": {
        "tags": [
          "Calificaciones"
        ],
        "summary": "Obtener las calificaciones",
        "description": "Método para obtener las calificaciones de los estudiantes",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notas y estados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/calificacionesRes"
                }
              }
            }
          },
          "404": {
            "description": "Curso inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Calificaciones"
        ],
        "summary": "Guardar las calificaciones",
        "description": "Método para guardar las calificaciones",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/calificacionesGuardar"
              },
              "example": {
                "calificaciones": [
                  {
                    "matriculaId": 1,
                    "nota1": 8.5,
                    "nota2": 7.5,
                    "nota3": 9,
                    "reposición": null
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calificaciones guardadas como borrador, se calcula la nota final automáticamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/calificacionesRes"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Curso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cursos/{cursoId}/calificaciones/{calificacionId}": {
      "patch": {
        "tags": [
          "Calificaciones"
        ],
        "summary": "Cambiar la nota de un estudiante.",
        "description": "Método para cambiar o actualizar la nota de evaluación de un estudiante.",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "description": "Id del curso.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "calificacionId",
            "in": "path",
            "required": true,
            "description": "Id de la calificación.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/notaCambio"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Se cambiaron las calificaciones con éxito.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/calificacionesCambio"
                }
              }
            }
          },
          "400": {
            "description": "Valor inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Nota no encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Calificaciones"
        ],
        "summary": "Eliminar nota",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "calificacionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nota eliminada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/eliminacionRes"
                }
              }
            }
          },
          "404": {
            "description": "Nota no encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cursos/{cursoId}/registros/{registro}/publicacion": {
      "post": {
        "tags": [
          "Publicación"
        ],
        "summary": "Subir las calificaciones de un registro.",
        "description": "Método para registrar las calificaciones.",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "registro",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirmar": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "confirmar"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Las calificaciones se han registrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/publicacionRes"
                }
              }
            }
          },
          "422": {
            "description": "Existen notas inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Curso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Publicación"
        ],
        "summary": "Quitar publicación de un registro.",
        "description": "Método para eliminar una publicación.",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "description": "Id del curso.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "registro",
            "in": "path",
            "required": true,
            "description": "Número del registro.",
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Publicación eliminada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/eliminacionRes"
                }
              }
            }
          },
          "404": {
            "description": "Error al eliminar la publicación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cursos/{cursoId}/informe": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "summary": "Descargar informe pdf del curso",
        "description": "Método para generar un informe pdf del curso.",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "description": "Id del curso.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Informe creado exitosamente",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Error al generar un informe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Curso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/cursos/{cursoId}/exportar": {
      "get": {
        "tags": [
          "Reportes"
        ],
        "summary": "Exportar calificaciones del curso a Excel",
        "description": "Descarga un archivo .xlsx con el listado de estudiantes y sus calificaciones: nota1, nota2, nota3, reposicion y notaFinal. Solo para docentes autorizados del curso. La exportación no modifica las notas.",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archivo Excel de calificaciones",
            "headers": {
              "content-disposition": {
                "description": "Nombre sugerido del archivo descargado",
                "schema": {
                  "type": "string"
                },
                "example": "attachment; filename=\"calificaciones_curso_1.xlsx\""
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Curso no encontrado o no disponible para el docente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/profesor/{profesorId}/contra": {
      "post": {
        "tags": [

    "/api/v1/profesor/{profesorId}/email": {
      "patch": {
        "tags": [
          "Docente"
        ],
        "summary": "Actualizar email",
        "description": "Método para actualizar el correo electrónico de un docente.",
        "parameters": [
          {
            "name": "profesorId",
            "in": "path",
            "required": true,
            "description": "Id del docente.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/correo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Correo actualizado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/correoRes"
                }
              }
            }
          },
          "400": {
            "description": "Error al actualizar el correo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Docente no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {

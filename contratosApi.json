            "type": "string",
            "pattern": "^[0-9]{8}-?[0-9]$",
            "example": "00000000-0",
            "description": "Identificador de acceso de 9 dígitos; se acepta con o sin guion. Se comprueba formato, no el dígito verificador."
          },
          "contrasena": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Contraseña del docente. Límite adicional: 72 bytes UTF-8. No es su DUI."
          }
        },
        "required": [
          "dui",
          "contrasena"
        ]
      },

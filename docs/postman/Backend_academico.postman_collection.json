{
  "info": {
    "name": "UEES - Portal completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contrato completo: login, sesión, cursos, notas, publicaciones, archivos y perfil. Configura las variables antes de ejecutar; las escrituras modifican la base seleccionada."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenOtro",
      "value": "",
      "type": "string"
    },
    {
      "key": "profesorId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "cursoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "matriculaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "calificacionId",
      "value": "1001",
      "type": "string"
    },
    {
      "key": "dui",
      "value": "",
      "type": "string"
    },
    {
      "key": "contrasena",
      "value": "",
      "type": "string"
    },
    {
      "key": "contrasenaNueva",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login DUI + contraseña",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"dui\":\"{{dui}}\",\"contrasena\":\"{{contrasena}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const data = pm.response.json().data; pm.collectionVariables.set(\"token\", data.token); pm.collectionVariables.set(\"profesorId\", String(data.profesorId)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar sesión",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sesion"
          }
        }
      ]
    },
    {
      "name": "Lecturas y descargas",
      "item": [
        {
          "name": "Mis cursos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/profesor/{{profesorId}}/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle del curso",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Estudiantes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/estudiantes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Calificaciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/calificaciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Descargar PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/informe"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Descargar Excel",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/exportar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Escrituras: revisar antes de ejecutar",
      "item": [
        {
          "name": "Guardar una nota como borrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/calificaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calificaciones\": [{\"matriculaId\": {{matriculaId}}, \"nota1\": 8.5}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Modificar una calificación",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/calificaciones/{{calificacionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"nota2\": 7.5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Publicar registro 1 (requiere todas sus notas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/registros/1/publicacion",
            "body": {
              "mode": "raw",
              "raw": "{\"confirmar\": true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Despublicar registro 1",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/registros/1/publicacion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Carga de estudiantes: selecciona un archivo",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/estudiantes/cargaMasiva",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar correo propio",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/profesor/{{profesorId}}/email",
            "body": {
              "mode": "raw",
              "raw": "{\"correo\":\"docente.demo@example.test\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar calificación (revisar ID antes)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}/calificaciones/{{calificacionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar contraseña propia (revisar cuerpo)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/profesor/{{profesorId}}/contra",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"contraseñaActual\":\"{{contrasena}}\",\"contraseñaNueva\":\"{{contrasenaNueva}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Comprobaciones de permiso",
      "item": [
        {
          "name": "Sin sesión",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Curso ajeno con token de otro docente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cursos/{{cursoId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenOtro}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

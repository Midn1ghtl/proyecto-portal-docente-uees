-- SOLO REFERENCIA / INSTALACIÓN NUEVA EN UNA BASE VACÍA.
-- NO EJECUTAR SOBRE LA BASE NEON ACTUAL: usar 02_ACTUALIZAR_NEON.sql.
-- Copia estructural corregida del archivo recibido; no incluye sus INSERT.
-- No se inventan DUIs, contraseñas, estudiantes, matrículas ni asignaciones.
BEGIN;
DO $$
BEGIN
  IF EXISTS(SELECT 1 FROM pg_namespace WHERE nspname='universidaduees') THEN
    RAISE EXCEPTION 'Solo para una base nueva sin esquema universidaduees. En Neon existente usar 02_ACTUALIZAR_NEON.sql.';
  END IF;
END $$;
CREATE SCHEMA universidaduees;

CREATE TABLE universidaduees.cursos (
  cursoid integer PRIMARY KEY,
  nombre varchar(50) NOT NULL,
  horario varchar(20)
);
CREATE TABLE universidaduees.profesores (
  profesorid varchar(9) PRIMARY KEY,
  nombre varchar(100) NOT NULL,
  apellidos varchar(100) NOT NULL,
  email varchar(250) UNIQUE,
  contrahash text NOT NULL,
  sexo char(1) CHECK (sexo IN ('F','M','O')),
  telefono varchar(15)
);
CREATE TABLE universidaduees.estudiantes (
  estudianteid integer PRIMARY KEY,
  nombre varchar(100) NOT NULL,
  apellidos varchar(100) NOT NULL,
  cif varchar(20) NOT NULL UNIQUE,
  email varchar(150) NOT NULL UNIQUE,
  matriculaid varchar(50) NOT NULL UNIQUE,
  cursoid integer NOT NULL REFERENCES universidaduees.cursos(cursoid),
  fechanacimiento date,
  sexo char(1) CHECK (sexo IN ('F','M','O'))
);
CREATE TABLE universidaduees.asignaturas (
  asignaturaid integer PRIMARY KEY,
  nombre varchar(50) NOT NULL,
  cursoid integer NOT NULL REFERENCES universidaduees.cursos(cursoid),
  profesorid varchar(9) NOT NULL REFERENCES universidaduees.profesores(profesorid)
);
CREATE TABLE universidaduees.evaluaciones (
  evaluacionesid integer PRIMARY KEY,
  asignaturaid integer NOT NULL REFERENCES universidaduees.asignaturas(asignaturaid),
  ponderacion integer NOT NULL CHECK (ponderacion BETWEEN 0 AND 100),
  fecha date,
  nombreevaluacion varchar(50) NOT NULL,
  UNIQUE(asignaturaid,nombreevaluacion)
);
CREATE TABLE universidaduees.matricula (
  asignaturaid integer NOT NULL REFERENCES universidaduees.asignaturas(asignaturaid),
  estudianteid integer NOT NULL REFERENCES universidaduees.estudiantes(estudianteid),
  cursoid integer NOT NULL REFERENCES universidaduees.cursos(cursoid),
  fechamatricula date NOT NULL DEFAULT CURRENT_DATE,
  PRIMARY KEY(asignaturaid,estudianteid)
);
CREATE TABLE universidaduees.calificaciones (
  calificacionid integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  asignaturaid integer NOT NULL,
  estudianteid integer NOT NULL,
  docenteid varchar(9) NOT NULL REFERENCES universidaduees.profesores(profesorid),
  nota1 numeric(5,2) CHECK(nota1 BETWEEN 0 AND 10),
  nota2 numeric(5,2) CHECK(nota2 BETWEEN 0 AND 10),
  nota3 numeric(5,2) CHECK(nota3 BETWEEN 0 AND 10),
  reposicion numeric(5,2) CHECK(reposicion BETWEEN 0 AND 10),
  notafinal numeric(5,2) CHECK(notafinal BETWEEN 0 AND 10),
  FOREIGN KEY(asignaturaid,estudianteid) REFERENCES universidaduees.matricula(asignaturaid,estudianteid) ON DELETE CASCADE,
  UNIQUE(asignaturaid,estudianteid)
);
CREATE TABLE universidaduees.publicaciones_registros (
  asignaturaid integer NOT NULL REFERENCES universidaduees.asignaturas(asignaturaid),
  registro smallint NOT NULL CHECK(registro IN (1,2,3)),
  publicado boolean NOT NULL DEFAULT false,
  actualizado_en timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY(asignaturaid,registro)
);
-- La final la calcula el backend: nota1*0.30 + nota2*0.30 + nota3*0.40.
-- Si falta alguna nota ordinaria devuelve null. Reposición no altera la final.
-- No se crean docentes sin un ID real y un hash bcrypt válido.
-- Si se prepara una instalación nueva, los datos los carga el equipo responsable,
-- en orden: cursos, profesores/estudiantes, asignaturas, matrículas, calificaciones.
COMMIT;